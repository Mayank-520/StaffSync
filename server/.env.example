# ========================================================
# StaffSync Backend Environment Configuration Blueprint
# Instructions:
# 1. Copy this file to .env in the server/ directory:
#    cp .env.example .env (or on Windows: Copy-Item .env.example .env)
# 2. Fill in your own real values below.
# 3. DO NOT commit your .env file to Git!
# ========================================================

# Server port and environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your own MongoDB Atlas connection URI)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/staffsync?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/staffsync?retryWrites=true&w=majority

# JSON Web Token (JWT) Configuration
# Generate a secure 32+ character string for production
JWT_SECRET=replace_with_a_secure_random_string_32_characters_or_more
JWT_EXPIRE=7d

# Allowed Frontend URL for Cross-Origin Resource Sharing (CORS)
# Supports comma-separated origins, localhost, or deployed Vercel domains
CLIENT_URL=http://localhost:5173,https://your-staffsync-frontend.vercel.app
